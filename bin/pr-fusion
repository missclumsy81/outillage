#!/usr/bin/env bash
# pr-fusion — fusionne une PR GitHub par merge commit, resynchronise la branche
# par défaut et, en option, démarre la branche suivante.
# Usage : pr-fusion <numéro> [nouvelle-branche]
set -euo pipefail

erreur() {
  echo "pr-fusion : $*" >&2
  exit 1
}

# --- Arguments ---------------------------------------------------------------
if [[ $# -lt 1 || $# -gt 2 ]]; then
  echo "Usage : pr-fusion <numéro> [nouvelle-branche]" >&2
  exit 2
fi
pr="$1"
nouvelle="${2:-}"
[[ "$pr" =~ ^[0-9]+$ ]] || erreur "numéro de PR invalide : $pr"

# --- 1. Préconditions --------------------------------------------------------
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || erreur "pas dans un dépôt Git"
gh auth status >/dev/null 2>&1 || erreur "gh n'est pas connecté (gh auth login)"
[[ -z "$(git status --porcelain)" ]] || erreur "arbre de travail non propre (voir git status)"
if [[ -n "$nouvelle" ]]; then
  git check-ref-format --branch "$nouvelle" >/dev/null 2>&1 \
    || erreur "nom de branche invalide : $nouvelle"
  if git show-ref --verify --quiet "refs/heads/$nouvelle"; then
    erreur "la branche $nouvelle existe déjà"
  fi
fi

defaut="$(gh repo view --json defaultBranchRef --jq .defaultBranchRef.name)"

# --- 2. Affichage de la PR ---------------------------------------------------
etat="$(gh pr view "$pr" --json state --jq .state)" || erreur "PR #$pr introuvable"
branche="$(gh pr view "$pr" --json headRefName --jq .headRefName)"

echo "PR #$pr"
gh pr view "$pr" --json title,headRefName,baseRefName \
  --jq '"  Titre   : \(.title)\n  Branche : \(.headRefName) -> \(.baseRefName)"'
echo "  État    : $etat"
echo "Contrôles CI :"
gh pr checks "$pr" || true   # code non nul si échec, en cours ou absence de CI : affiché, pas bloquant

[[ "$etat" == "OPEN" ]] || erreur "la PR #$pr est $etat, fusion impossible"

# --- 3. Confirmation ---------------------------------------------------------
read -r -p "Fusionner la PR #$pr par merge commit ? [o/N] " reponse || reponse=""
[[ "$reponse" =~ ^[oO]$ ]] || erreur "abandon, rien n'a été modifié"

# --- 4. Fusion ---------------------------------------------------------------
gh pr merge "$pr" --merge --delete-branch

# --- 5. Resynchronisation (idempotente : gh a pu changer de branche lui-même) -
git switch --quiet "$defaut"
git fetch --prune --quiet
git merge --ff-only --quiet "origin/$defaut"

# --- 6. Branche locale fusionnée ---------------------------------------------
# -d refuse une branche non fusionnée : protège d'éventuels commits locaux non poussés.
if [[ "$branche" != "$defaut" ]] && git show-ref --verify --quiet "refs/heads/$branche"; then
  git branch -d "$branche"
fi

# --- 7. Branche suivante (optionnelle) ---------------------------------------
if [[ -n "$nouvelle" ]]; then
  git switch -c "$nouvelle"
fi

# --- 8. Contrôle -------------------------------------------------------------
echo
echo "== Contrôle =="
git status -sb
git --no-pager log --first-parent --oneline -5
git branch -a
